# Servidor local
PORT=8787
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8787

# Direcciones y cálculo de rutas. Nunca usar VITE_ para esta llave.
GEOAPIFY_API_KEY=
GEOAPIFY_DAILY_LIMIT=2500
VIN_DECODER_DAILY_LIMIT=5000

# Desarrollo local únicamente. En producción debe ser false y se debe configurar
# AUTH_DELIVERY_WEBHOOK_URL.
ALLOW_INSECURE_AUTH_CODES=true

# Correo por Resend. Con RESEND_FROM vacío se usa onboarding@resend.dev, que
# sólo entrega al correo con el que se registró la cuenta de Resend: sirve para
# montar y probar, no para invitar a nadie. Con dominio verificado, algo como
# "FleetHub <codigos@tudominio.com>".
RESEND_API_KEY=
RESEND_FROM=

# SMS por Twilio. Mejor una clave de API (SK…) que el Auth Token: se revoca
# sola. Mejor un Messaging Service (MG…) que un número suelto: lleva asociada
# la campaña 10DLC que exigen las operadoras de Estados Unidos.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Alternativa al 10DLC: Twilio Verify genera, manda y comprueba el código con
# sus propios números, ya registrados ante las operadoras. Con esto puesto, el
# SMS deja de necesitar marca ni campaña — y el código deja de ser nuestro.
TWILIO_VERIFY_SERVICE_SID=

# Salida propia, por si se prefiere resolver la entrega fuera. Recibe
# { channel, to, addressee, purpose, code, expiresAt, language, name }.
AUTH_DELIVERY_WEBHOOK_URL=
AUTH_DELIVERY_TOKEN=

# Correos de las cuentas internas de soporte de FleetHub, separados por comas.
# No es un dato que el frontend ni una petición de registro puedan modificar.
FLEETHUB_STAFF_EMAILS=

# Logs y avisos. Los destinos son opcionales; sin ellos los logs JSON siguen
# disponibles en la plataforma, pero nadie recibe una alerta externa.
FLEETHUB_LOG_LEVEL=info
SENTRY_DSN=
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TOKEN=

# Intentos admitidos por IP. Suben para una demo con público y bajan para un
# despliegue expuesto; cero en cualquiera de ellos apaga ese límite.
RATE_COMPANIES_PER_HOUR=3
RATE_PASSWORDS_PER_10MIN=10
RATE_CODES_PER_10MIN=5
RATE_CODE_CHECKS_PER_10MIN=20

# Identidad del despliegue en logs, avisos y /api/health.
FLEETHUB_ENVIRONMENT=development
FLEETHUB_RELEASE=
FLEETHUB_SERVICE=fleethub-api

# Monitor de disponibilidad. Lo usa scripts/check-health.mjs y el workflow
# Disponibilidad; en GitHub van como variables del repositorio, no aquí.
HEALTH_URL=
HEALTH_BUDGET_MS=5000

# Frontend. Para producción configure un proveedor de tiles con sus condiciones
# de uso y atribución correspondientes. Sin VITE_TILE_URL el build avisa, y con
# CONTEXT=production se detiene: el servidor público de OpenStreetMap no admite
# producción. Para desplegar así a propósito, FLEETHUB_ALLOW_PUBLIC_TILES=true.
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
FLEETHUB_ALLOW_PUBLIC_TILES=

# Almacén local del servidor de desarrollo. Las pruebas E2E los apuntan a
# test-results/ para no tocar el almacén de trabajo.
FLEETHUB_STORE_FILE=
FLEETHUB_PHOTO_DIR=
